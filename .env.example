# Pearls360 Employee Portal — environment variables
#
# Copy to `.env.local` for local development (git-ignored) and set the same
# names in Vercel → Project → Settings → Environment Variables.
# None of these are exposed to the browser: there are no VITE_* variables.

# --- Database (Supabase Postgres, used only as a database) -------------------
# Supabase Dashboard → your project → "Connect" (top bar) → "Transaction pooler".
# Port 6543. Replace [YOUR-PASSWORD] with the database password
# (Project Settings → Database → "Reset database password" if you don't have it).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Used only by `npm run db:migrate` (multi-statement DDL + advisory lock).
# Supabase Dashboard → "Connect" → "Session pooler" (port 5432).
# Defaults to DATABASE_URL when unset.
MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional but recommended: enables full TLS certificate verification.
# Project Settings → Database → "SSL Configuration" → "Download certificate".
# Paste the PEM contents (newlines may be written as \n).
DATABASE_CA_CERT=

# Set to "disable" only for a local Postgres without TLS.
DATABASE_SSL=require

# Max connections per serverless instance (keep small behind the pooler).
DATABASE_POOL_MAX=3

# --- Application -------------------------------------------------------------
# Public origin used for CSRF checks and one-time links.
APP_ORIGIN=https://login.pearls360designs.com
# Optional extra origins accepted by the CSRF check (comma-separated).
ALLOWED_ORIGINS=

# --- Email (optional) --------------------------------------------------------
# When unset, activation / reset links are shown once to the admin to share
# through a trusted channel. When set, they are emailed via Resend.
RESEND_API_KEY=
EMAIL_FROM=Pearls360 <no-reply@pearls360designs.com>

# --- One-time admin bootstrap (`npm run admin:create`) -----------------------
# Only needed while running the bootstrap command; remove afterwards.
# If unset, the command prompts (password input is hidden).
# Password must be at least 12 characters and must not contain the email name.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_INITIAL_PASSWORD is accepted as an alias for ADMIN_PASSWORD.

